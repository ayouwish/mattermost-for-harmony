{
  "name": "MattermostHarmonyOS",
  "version": "0.2.0",
  "private": true,
  "description": "Mattermost client for HarmonyOS (RNOH)",
  "scripts": {
    "start": "react-native start",
    "harmony": "react-native start --config metro.config.harmony.js",
    "tsc": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "codegen": "react-native codegen-harmony --cpp-output-path ./entry/src/main/cpp/generated --ets-output-path ./entry/src/main/ets/generated",
    "bundle:harmony": "react-native bundle --platform harmony --dev false --entry-file index.js --bundle-output entry/src/main/resources/rawfile/bundle.harmony.js --assets-dest entry/src/main/resources/rawfile/assets --config metro.config.harmony.js",
    "bundle:harmony:dev": "react-native bundle --platform harmony --dev true --entry-file index.js --bundle-output entry/src/main/resources/rawfile/bundle.harmony.js --assets-dest entry/src/main/resources/rawfile/assets --config metro.config.harmony.js"
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "0.84.2",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "shell-quote": "^1.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "latest",
    "@react-native-oh/react-native-harmony-cli": "^0.84.2",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/react": "^18.2.65",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.7.0"
  },
  "harmony": {
    "alias": "mattermost",
    "codegenConfig": [
      {
        "version": 1,
        "type": "modules",
        "specPaths": [
          "./src/specs/v1"
        ]
      }
    ]
  }
}
